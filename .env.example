# ------------------------------------------------------------------
# Beispiel-Umgebungsvariablen fuer dieses Repository.
#
# Die App selbst benoetigt zur Laufzeit KEINE Umgebungsvariablen:
# Server-URL und Zugangsdaten werden beim Login in der App eingegeben
# und in expo-secure-store auf dem Geraet abgelegt.
#
# Diese Variablen werden nur vom Seed-Skript fuer eine
# Nextcloud-TESTINSTANZ verwendet (scripts/seed-nextcloud.sh,
# aufrufbar ueber `just seed` / `just unseed`; das justfile laedt
# .env automatisch via dotenv-load).
#
# Kopieren nach .env (ist gitignored) und Werte eintragen.
# NIEMALS echte Zugangsdaten committen.
# ------------------------------------------------------------------

# Basis-URL der Nextcloud-Testinstanz (ohne abschliessenden /)
NC_URL=https://cloud.example.com

# Benutzername auf der Testinstanz
NC_USER=admin

# App-Passwort (Nextcloud: Einstellungen -> Sicherheit -> App-Passwort).
# Ein App-Passwort ist einem Konto-Passwort vorzuziehen.
NC_PASS=
