+// PATCH: cascade layout for overlapping events.
+//
+// `layoutDayEvents` packs events into the first free column, so which one ends
+// up leftmost depends on iteration order rather than on anything the reader
+// cares about. For a cascade the order has to be meaningful: the longest event
+// sits at the back, full width, and shorter ones are indented and painted over
+// it. A short meeting nested inside a long block therefore stays visible and
+// tappable instead of being buried under it. Ties go to the earlier event, so
+// equal-length events still read left to right in time order.
+//
+// The indent counts only the events a box actually overlaps, not everything in
+// its run. Two short events inside one long block do not overlap each other, so
+// they share an indent and each keeps the full remaining width instead of
+// stepping further right for no reason.
+function cascadeLayout<T>(
+  positioned: PositionedEvent<T>[],
+): Map<PositionedEvent<T>, { depth: number; maxDepth: number }> {
+  const out = new Map<PositionedEvent<T>, { depth: number; maxDepth: number }>();
+  const overlaps = (a: PositionedEvent<T>, b: PositionedEvent<T>) =>
+    a.startHours < b.startHours + b.durationHours &&
+    b.startHours < a.startHours + a.durationHours;
+
+  const byStart = [...positioned].sort(
+    (a, b) => a.startHours - b.startHours || b.durationHours - a.durationHours,
+  );
+
+  let cluster: PositionedEvent<T>[] = [];
+  let clusterEnd = 0;
+
+  const flush = () => {
+    // Back to front: longest first, then earliest.
+    const ordered = [...cluster].sort(
+      (a, b) => b.durationHours - a.durationHours || a.startHours - b.startHours,
+    );
+    const depths: number[] = [];
+    let maxDepth = 0;
+    ordered.forEach((p, i) => {
+      let depth = 0;
+      for (let j = 0; j < i; j += 1) {
+        if (overlaps(p, ordered[j])) depth = Math.max(depth, depths[j] + 1);
+      }
+      depths.push(depth);
+      maxDepth = Math.max(maxDepth, depth);
+    });
+    ordered.forEach((p, i) => out.set(p, { depth: depths[i], maxDepth }));
+    cluster = [];
+  };
+
+  for (const p of byStart) {
+    // A gap ends the run of mutual overlaps: everything after it is independent.
+    if (cluster.length > 0 && p.startHours >= clusterEnd) flush();
+    clusterEnd = cluster.length === 0
+      ? p.startHours + p.durationHours
+      : Math.max(clusterEnd, p.startHours + p.durationHours);
+    cluster.push(p);
+  }
+  if (cluster.length > 0) flush();
+
+  return out;
+}
